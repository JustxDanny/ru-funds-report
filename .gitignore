# Secrets — must never be committed.
.env

# Generated reports.
out/

# Scheduled-task runtime logs.
logs/

# Rendered task XML — install_task.ps1 generates from .tmpl per machine.
taskscheduler/funds-report.xml

# Cached HTML/JS/xlsx from ad-hoc investigation.
*.html
*.js
*.xlsx
!tests/fixtures/*.html
!tests/fixtures/*.xlsx

# Python.
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# Editor / agent state.
.claude/
.vscode/
.idea/
.claude/reviews/
